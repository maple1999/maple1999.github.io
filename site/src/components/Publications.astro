---
import Icon from './Icon.astro';
import { publications, links, ui } from '../data/profile';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
---
<section class="academic-section" id="publications" aria-labelledby="publications-title">
  <header class="academic-heading"><p class="eyebrow">{en ? 'Publications' : '论文成果'}</p><h2 id="publications-title">{en ? 'Published & accepted.' : '已发表与已录用。'}</h2></header>
  <div class="publication-list">{publications.map(p => <article class="publication">
    <div class="publication-meta"><span>{p.venue}</span><span>{t(p.status, lang)} · {t(p.role, lang)}</span></div>
    <h3>{p.title}</h3>
    <p class="publication-authors">{p.authors.map((author, i) => <><span class:list={{ me: author.me }}>{author.name}</span>{author.corresponding ? '*' : ''}{i < p.authors.length - 1 ? ', ' : ''}</>)}</p>
    <div class="publication-links">{p.resources.map(resource => <a class="academic-link" href={resource.href} target="_blank" rel="noopener noreferrer">{t(resource.label, lang)}<Icon name="external" /></a>)}
      {p.awards.length > 0 && <a class="publication-award" href="https://cvpr.thecvf.com/Conferences/2026/ComputeReporting" target="_blank" rel="noopener noreferrer"><Icon name="star" />{t(p.awards[0], lang)}<Icon name="external" /></a>}
    </div>
  </article>)}</div>
  <div class="publication-footer"><p>{t(ui.sections.publications.underReviewNote, lang)}</p><a class="academic-link" href={links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar<Icon name="external" /></a></div>
</section>
