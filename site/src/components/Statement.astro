---
import { statement } from '../data/profile';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section statement">
  <div class="wrap">
    <div class="statement-inner reveal">
      <span class="eyebrow">{t(statement.eyebrow, lang)}</span>
      <p class="statement-text" set:html={t(statement.text, lang)} />
      <p class="statement-note">{t(statement.note, lang)}</p>
    </div>
  </div>
</section>

<style>
  .statement-note { margin-top: 1.4rem; color: var(--text-muted); font-size: .93rem; line-height: 1.8; }
</style>
