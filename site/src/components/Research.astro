---
import { researchAreas, ui } from '../data/profile';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui.sections.research;
const accents = ['gold', 'teal', 'violet'];
---
<section class="section" id="research">
  <div class="wrap">
    <header class="section-head reveal">
      <span class="eyebrow">{t(s.eyebrow, lang)}</span>
      <h2 class="section-title">{t(s.title, lang)}</h2>
    </header>

    <div class="research-grid">
      {researchAreas.map((area, i) => (
        <article class="card research-card reveal"
                 data-accent={accents[i]}
                 style={`--reveal-delay:${i * 90}ms`}>
          <span class="research-index mono">{area.index}</span>
          <h3 class="research-title">{t(area.title, lang)}</h3>
          <p class="research-summary" set:html={t(area.summary, lang)} />
          <ul class="tag-row">
            {(lang === 'en' ? area.keywords : area.keywordsZh).map((k) => (
              <li class="tag">{k}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
