---
import Icon from './Icon.astro';
import { recommendations, ui } from '../data/profile';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui.sections.references;
---
<section class="section" id="references">
  <div class="wrap">
    <header class="section-head reveal">
      <span class="eyebrow">{t(s.eyebrow, lang)}</span>
      <h2 class="section-title">{t(s.title, lang)}</h2>
    </header>

    <div class="ref-grid">
      {recommendations.map((r, i) => (
        <article class="ref-card reveal" data-accent={r.accent} style={`--reveal-delay:${i * 90}ms`}>
          <svg class="ref-mark" viewBox="0 0 32 24" aria-hidden="true">
            <path d="M13 3C7 5.5 3.5 10 3.5 15.5c0 3.3 2 5.5 4.8 5.5 2.6 0 4.5-1.9 4.5-4.4 0-2.4-1.7-4.2-4-4.2-.5 0-1 .1-1.3.2.7-2.6 2.8-5 5.8-6.6L13 3Zm15 0c-6 2.5-9.5 7-9.5 12.5 0 3.3 2 5.5 4.8 5.5 2.6 0 4.5-1.9 4.5-4.4 0-2.4-1.7-4.2-4-4.2-.5 0-1 .1-1.3.2.7-2.6 2.8-5 5.8-6.6L28 3Z"
                  fill="currentColor"/>
          </svg>

          <div class="ref-quotes">
            {r.quotes.map((q) => (
              <blockquote class="ref-quote">{t(q, lang)}</blockquote>
            ))}
          </div>

          <footer class="ref-by">
            <p class="ref-name">{t(r.name, lang)}</p>
            <p class="ref-title">{t(r.title, lang)}</p>
            <p class="ref-affil">{t(r.affiliation, lang)}</p>
            <p class="ref-relation">{t(r.relation, lang)}</p>
            <a class="link-arrow ref-link" href={r.letter} target="_blank" rel="noopener noreferrer">
              {t(s.readLetter, lang)}<Icon name="external" />
            </a>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>
