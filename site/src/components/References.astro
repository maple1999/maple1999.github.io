---
import { recommendations } from '../data/profile';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="supervisor-list" id="references">
  {recommendations.map(person => <article><h3>{t(person.name, lang)}</h3><p>{t(person.affiliation, lang)}</p><p>{t(person.relation, lang)}</p></article>)}
</div>
